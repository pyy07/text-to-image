# 说明：
# - 由于某些环境会屏蔽 `.env.example`（匹配 *.env*），这里用 `env.example` 作为模板。
# - 你本地使用时：`cp env.example .env` 然后按需修改。

# ----------------------------
# 基础
# ----------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# 本地测试：是否允许匿名生成（开发环境默认允许；显式设置 false 可关闭）
ALLOW_ANONYMOUS="true"

# ----------------------------
# 文生图（OpenAI 兼容接口 / modelscope z-image）
# ----------------------------
AI_PROVIDERS="openai"
AI_PROVIDER="openai"

# modelscope（或其他 OpenAI 兼容服务）的 key
OPENAI_API_KEY="your-openai-compatible-key"

# 接口归属说明：
# - 首页（文生图 / 合成 / 编辑）：使用 OPENAI_BASE_URL → 填 ModelScope 地址即可走 ModelScope
# - 模型试用、文生漫：共用 OPENAI_UNIAPI_BASE_URL + OPENAI_UNIAPI_API_KEY（文生漫自动用 .../gemini 端点）

# OpenAI 兼容接口地址（以 /v1 结尾）；首页文生图/合成/编辑用此地址（建议 ModelScope）
OPENAI_BASE_URL="https://your-openai-compatible-endpoint/v1"

# 模型试用专用：UniAPI 等（试用页/文生漫/文生动走此地址）。填 .../v1 或 .../gemini 均可，程序会自动识别
# OPENAI_UNIAPI_BASE_URL="https://api.uniapi.io/v1"
# OPENAI_UNIAPI_BASE_URL="https://api.uniapi.io/gemini"
# 模型试用用的 API Key（不填则沿用 OPENAI_API_KEY）
# OPENAI_UNIAPI_API_KEY="your-uniapi-key"

# 允许的模型列表（用于后端校验）
OPENAI_MODELS="z-image"

# 先进模型（UniAPI 等付费模型，仅管理员或后台「网站设置」中配置的授权用户可用）
# ADVANCED_OPENAI_MODELS="flux-1.1-pro,other-paid-model"
# 模型试用授权：在 /admin 用户管理中对用户点击「设为VIP」即可，无需环境变量

# ----------------------------
# 模型试用（按模态配置，参考 https://uniapi.ai/dashboard/model_list）
# ----------------------------
# 图像：文生图/图像编辑等（OpenAI 兼容 images API）
TRIAL_MODELS_IMAGE="dall-e-3,flux-1.1-pro,flux-schnell,gpt-image-1"
# 视频：文生视频等（如 Kling）
TRIAL_MODELS_VIDEO="kling-v1,kling-v1-5,kling-v2"
# 音频：语音识别、TTS 等
TRIAL_MODELS_AUDIO="whisper-1,tts-1,tts-1-hd"
# 文本：大语言模型
TRIAL_MODELS_TEXT="gpt-4o,gpt-4o-mini,claude-3-5-sonnet-20241022"
# 音乐：音乐生成（无则留空）
# TRIAL_MODELS_MUSIC=""

# 默认模型（不填则取 OPENAI_MODELS 的第一个）
OPENAI_MODEL="z-image"

# 默认图片尺寸（images.generate 的 size）
OPENAI_IMAGE_SIZE="1024x1024"

# ----------------------------
# 文生漫（与模型试用共用 UniAPI 配置，无需单独 COMIC_*）
# ----------------------------
# 是否开启文生漫：true 时使用 OPENAI_UNIAPI_BASE_URL + OPENAI_UNIAPI_API_KEY 的 Gemini 端点（自动推导 .../gemini）
COMIC_ENABLED="false"

# 文生漫模型（可选，默认 gemini-2.0-flash-exp）；须支持出图
# COMIC_GEMINI_MODEL="gemini-2.0-flash-exp"

# 文生漫支持 GitHub 仓库（仅 README）时，可选填 GitHub Token 以提高限流额度
# 不填时未认证请求仍可访问公开仓库，但受 GitHub API 限流限制
GITHUB_TOKEN=""

# ----------------------------
# 文生动画（与文生漫共用 UniAPI 配置）
# ----------------------------
# 是否开启文生动画：true 时根据用户描述生成 SVG 或 H5 动画
ANIMATION_ENABLED="false"

# 文生动画模型（可选，默认 gemini-3-flash-preview）；须支持文本/代码生成
# ANIMATION_GEMINI_MODEL="gemini-3-flash-preview"

# 案例列表（图片+漫画）是否允许删除，设为 true 时在案例页显示删除按钮
ALLOW_DELETE="false"

# ----------------------------
# 对象存储：Vercel Blob（只存 URL，不双写）
# ----------------------------
# Vercel Project -> Storage -> Blob -> Read/Write Token
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# （可选）上传路径前缀，会上传到 `${VERCEL_BLOB_PREFIX}/...`
VERCEL_BLOB_PREFIX="generated"

# ----------------------------
# 微信登录（可选）
# ----------------------------
WECHAT_APP_ID="your_wechat_app_id"
WECHAT_APP_SECRET="your_wechat_app_secret"

# ----------------------------
# 后台管理员
# ----------------------------
# 配置后使用该账号密码在 /admin/login 登录后台
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="你的密码"

# ----------------------------
# 代理（可选）
# ----------------------------
HTTPS_PROXY=""
HTTP_PROXY=""


