// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  wechatOpenId  String?   @unique
  username      String?   @unique
  password      String?   // 存储 bcrypt 哈希后的密码
  nickname      String?
  avatar        String?
  usageCount    Int       @default(0)
  maxUsage      Int       @default(3)
  isPermanent   Boolean   @default(false)
  isAdmin       Boolean   @default(false) // 管理员可登录后台
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assets           Asset[]
  tasks            Task[]
  auditLogs        AuditLog[]  @relation("AuditLogUser")
  auditLogsAsActor AuditLog[]   @relation("AuditLogActor")

  @@map("users")
}

model Asset {
  id          String   @id @default(cuid())
  userId      String?
  description String
  // 资产操作类型：生成(generate) 或 编辑(edit)
  operation   String   @default("generate")
  // 编辑来源：若基于已有素材编辑，记录其 Asset ID
  sourceAssetId String?
  // 编辑来源：若基于上传图片编辑，记录输入图 URL（通常也是 Blob URL）
  inputImageUrl String? @db.Text
  // 历史字段：曾用于保存 SVG/HTML 代码。文生图后保留以兼容旧数据。
  svgCode     String?  @db.Text
  // 内容类型：当前仅使用 image（旧数据可能为 svg/html）
  type        String   @default("image")
  // 文生图：对象存储/外链地址（不做双写）
  imageUrl    String?  @db.Text
  // 图片 MIME，如 image/png
  mimeType    String?
  provider    String?  // AI Provider (gemini, openai, etc.)
  model       String?  // Model name (e.g., gemini-2.0-flash-exp, gpt-4o)
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  sourceAsset Asset? @relation("AssetSource", fields: [sourceAssetId], references: [id], onDelete: SetNull)
  derivedAssets Asset[] @relation("AssetSource")

  @@map("assets")
}

model Task {
  id            String   @id @default(cuid())
  userId        String?
  type          String   // 'edit' | 'compose' | 'comic'
  status        String   @default("pending") // 'pending' | 'processing' | 'completed' | 'failed' | 'expired'
  description   String   @db.Text
  inputImageUrls String  @db.Text // JSON 数组存储输入图片 URL
  resultImageUrl String? @db.Text
  resultAssetId String?
  error         String?  @db.Text
  provider      String?
  model         String?
  size          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  expiresAt     DateTime // 30 分钟后过期

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([type, status])
  @@index([status, createdAt])
  @@index([expiresAt])
  @@map("tasks")
}

// 操作/审计日志：记录管理员与关键操作
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  // 操作用户（可为空表示系统）
  actorId    String?  // 管理员 ID（后台操作时）
  action     String   // 如 user.update, user.set_permanent, settings.update
  targetType String?  // 如 user, asset, settings
  targetId   String?  // 目标实体 ID
  details    String?  @db.Text // JSON 或简要描述
  createdAt  DateTime @default(now())

  user  User? @relation("AuditLogUser", fields: [userId], references: [id], onDelete: SetNull)
  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// 网站设置：键值存储
model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

